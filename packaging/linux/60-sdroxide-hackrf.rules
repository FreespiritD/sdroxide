# HackRF One and HackRF Pro (and Jawbreaker / rad1o), for sdroxide's native USB
# driver.
#
# sdroxide talks to these directly with nusb rather than through libusb,
# libhackrf or libSoapySDR, but the kernel-level requirement is the same: the
# invoking user needs write access to the usbfs node.
#
# TAG+="uaccess" hands an ACL to whoever is logged in at the active seat. That
# is better than the older GROUP="plugdev" recipe, which needs a group to exist,
# the user to be added to it, and a full re-login before it takes effect.
#
# Install:
#   sudo cp 60-sdroxide-hackrf.rules /usr/lib/udev/rules.d/
#   sudo udevadm control --reload
# then unplug and replug the radio.
#
# Great Scott Gadgets' own 53-hackrf.rules covers the same ids. If it is already
# installed this file is harmless duplication, not a conflict.

# HackRF One *and* HackRF Pro: Great Scott Gadgets ship one device descriptor
# for both boards, so 6089 is the id for either. Nor is the board revision in
# the descriptors (pre-rev-9 vs rev 9 and later) — sdroxide asks the opened
# device for both facts, and neither affects the rule.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6089", MODE="0660", TAG+="uaccess"

# Jawbreaker, the beta platform. 10 MHz - 6 GHz and no bias tee; sdroxide reads
# the narrower range off the product id rather than offering a HackRF One's.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="604b", MODE="0660", TAG+="uaccess"

# rad1o, the CCC badge. 50 MHz - 4 GHz, no bias tee.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="cc15", MODE="0660", TAG+="uaccess"

# The DFU bootloader. sdroxide never enters it and cannot flash firmware — use
# hackrf_spiflash for that — but a radio stuck here after an interrupted
# firmware write is otherwise invisible to a non-root user, and "the device
# disappeared" is a worse thing to debug than a stray rule line.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1fc9", ATTRS{idProduct}=="000c", MODE="0660", TAG+="uaccess"
